{
  "schemaVersion": 1,
  "id": "lsp-expander",
  "version": "1.0.0",
  "minWavemix": "1.1.0",
  "name": "LSP Expander",
  "description": "Gentle downward expander for reducing mic noise between phrases",
  "type": "lv2",
  "plugin": "http://lsp-plug.in/plugins/lv2/expander_mono",
  "input": "in",
  "output": "out",
  "config": {},
  "gpu": false,
  "requires": "Install lsp-plugins-lv2, or place the LV2 bundle in ~/.lv2",
  "default": false,
  "allowMultiple": true,
  "controls": [
    {
      "key": "mode",
      "param": "em",
      "label": "Mode (0 = down, 1 = up)",
      "min": 0,
      "max": 1,
      "step": 1,
      "unit": "",
      "default": 0,
      "integer": true,
      "raw_float": false,
      "scale": 1
    },
    {
      "key": "threshold",
      "param": "al",
      "label": "Threshold (linear)",
      "min": 0.001,
      "max": 1,
      "step": 0.001,
      "unit": "",
      "default": 0.02,
      "integer": false,
      "raw_float": true,
      "scale": 1
    },
    {
      "key": "ratio",
      "param": "er",
      "label": "Ratio",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "unit": ":1",
      "default": 1.6,
      "integer": false,
      "raw_float": true,
      "scale": 1
    },
    {
      "key": "knee",
      "param": "kn",
      "label": "Knee",
      "min": 0.0631,
      "max": 1,
      "step": 0.001,
      "unit": "",
      "default": 0.8,
      "integer": false,
      "raw_float": true,
      "scale": 1
    },
    {
      "key": "attack",
      "param": "at",
      "label": "Attack time",
      "min": 0,
      "max": 200,
      "step": 1,
      "unit": " ms",
      "default": 20,
      "integer": false,
      "raw_float": true,
      "scale": 1
    },
    {
      "key": "release",
      "param": "rt",
      "label": "Release time",
      "min": 0,
      "max": 2000,
      "step": 10,
      "unit": " ms",
      "default": 400,
      "integer": false,
      "raw_float": true,
      "scale": 1
    },
    {
      "key": "hold",
      "param": "hold",
      "label": "Hold time",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": " ms",
      "default": 100,
      "integer": false,
      "raw_float": true,
      "scale": 1
    },
    {
      "key": "makeup",
      "param": "mk",
      "label": "Makeup gain",
      "min": 0.25,
      "max": 4,
      "step": 0.01,
      "unit": "",
      "default": 1.0,
      "integer": false,
      "raw_float": true,
      "scale": 1
    }
  ]
}
